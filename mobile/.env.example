# PulseCast Mobile Environment Configuration Template
# Duplicate this file to .env (or pass environment defines via --dart-define)

# Production Backend Base URL (Render)
API_BASE_URL=https://internet-radio-stream.onrender.com

# Local Backend Base URL (for emulator/simulator development)
# Android Emulator: http://10.0.2.2:5000
# iOS Simulator / Desktop: http://localhost:5000
# LOCAL_API_BASE_URL=http://10.0.2.2:5000

# Default Icecast Audio Stream (AWS EC2)
DEFAULT_STREAM_URL=https://pulsecast.duckdns.org/pulsecast.mp3

# Network Request Timeout (Milliseconds)
CONNECT_TIMEOUT_MS=15000
RECEIVE_TIMEOUT_MS=15000

